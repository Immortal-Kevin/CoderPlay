<Window x:Class="DesktopCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面整理大师" Width="460" Height="340" MinWidth="360" MinHeight="310"
        WindowStartupLocation="CenterScreen" Background="#101826" Foreground="#F5F8FE"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F8FE" />
            <Setter Property="Background" Value="#23334B" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#4488B1E7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B4D8FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value=".48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Desktop Cleaner" FontSize="27" FontWeight="SemiBold" />
        <Border Grid.Row="1" Background="#17243A" CornerRadius="8" Margin="0,10,0,10" Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="Status" DockPanel.Dock="Top" Text="未整理" Foreground="#9ACCFF"
                           FontSize="18" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                <ScrollViewer Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Detail" Text="正在读取桌面图标…" TextWrapping="Wrap" Foreground="#CAD7EA"
                               FontSize="13" AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="ArrangeButton" Content="一键整理" Style="{StaticResource Action}" Background="#235ECC"
                    Click="ArrangeClicked" IsEnabled="False" />
            <Button x:Name="RestoreButton" Content="恢复桌面" Style="{StaticResource Action}" Margin="8,0,0,0"
                    Click="RestoreClicked" IsEnabled="False" />
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="v1.0" Foreground="#AABAD2" />
            <TextBlock x:Name="Count" Text="桌面图标 · —" Foreground="#AABAD2" />
        </DockPanel>
    </Grid>
</Window>
